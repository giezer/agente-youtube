# ─────────────────────────────────────────────
# YouTube Agent — Configuração
# ─────────────────────────────────────────────

# Chave gratuita do Pexels (imagens)
# 1. Crie conta em: https://www.pexels.com/api/
# 2. Copie a chave e cole aqui
PEXELS_API_KEY=cole_sua_chave_aqui

# Modelo Ollama para gerar roteiros
# Opções leves: llama3.2, mistral, gemma2:2b
# Execute: ollama pull llama3.2
OLLAMA_MODEL=llama3.2

# Host do Ollama (padrão quando rodando localmente)
OLLAMA_HOST=http://localhost:11434

# Voz TTS em português brasileiro (sem custo, usa servidores Microsoft)
# Opções: pt-BR-FranciscaNeural, pt-BR-AntonioNeural, pt-BR-BrendaNeural
TTS_VOICE=pt-BR-FranciscaNeural
